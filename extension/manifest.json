{
  "manifest_version": 3,
  "name": "FactShield",
  "version": "0.3.0",
  "description": "Check a highlighted claim against controlled sources, without leaving the page.",

  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://localhost:8000/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["capture.js", "popup/popup.js"],
      "run_at": "document_idle"
    }
  ],

  "action": { "default_title": "FactShield" },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
